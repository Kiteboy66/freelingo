# Backend service. Replace placeholder values and keep secrets in Railway.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379
SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
PORT=8000
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
TTS_PROVIDER=local
TTS_BASE_URL=http://xhosa-speech.railway.internal:9100
XHOSA_SPEECH_BASE_URL=http://xhosa-speech.railway.internal:9100
TTS_CACHE_ENABLED=true
AUDIO_STORAGE_PATH=/data/audio
AVATAR_STORAGE_PATH=/data/avatars
TTS_PREVIEW_STORAGE_PATH=/data/tts_previews
AVAILABLE_TARGET_LANGUAGES=["xh-ZA"]
COOKIE_SECURE=true
CORS_ORIGINS=["https://YOUR-FRONTEND-DOMAIN"]
APP_BASE_URL=https://YOUR-FRONTEND-DOMAIN
STRIPE_ENABLED=false
UVICORN_WORKERS=1
